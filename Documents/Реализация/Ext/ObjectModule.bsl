
Процедура ОбработкаПроведения(Отказ, Режим)
	// 1. Включаем запись движений
    Движения.Остатки.Записывать = Истина; 
    Движения.Продажи.Записывать = Истина;
    
    // 2. Запрос для расчета FIFO (по регистру Остатки)
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |    Товары.Наименование КАК Товар,
        |    СУММА(Товары.Количество) КАК НужноСписать
        |ПОМЕСТИТЬ ВТ_КСписанию
        |ИЗ
        |    Документ.Реализация.Товары КАК Товары
        |ГДЕ
        |    Товары.Ссылка = &Ссылка
        |СГРУППИРОВАТЬ ПО
        |    Товары.Наименование
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ
        |    ВТ_КСписанию.Товар КАК Товар,
        |    ВТ_КСписанию.НужноСписать КАК НужноСписать,
        |    Остатки.Партия КАК Партия,
        |    ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
        |    ЕСТЬNULL(Остатки.ЦенаОстаток, 0) КАК ЦенаОстаток
        |ИЗ
        |    ВТ_КСписанию КАК ВТ_КСписанию
        |    ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Остатки.Остатки(
        |        &МоментВремени,
        |        Товар В (ВЫБРАТЬ Товар ИЗ ВТ_КСписанию)) КАК Остатки
        |    ПО ВТ_КСписанию.Товар = Остатки.Товар
        |УПОРЯДОЧИТЬ ПО
        |    Товар,
        |    Остатки.Партия.МоментВремени";
    
    Запрос.УстановитьПараметр("Ссылка", Ссылка);
    Запрос.УстановитьПараметр("МоментВремени", МоментВремени());
    
    Выборка = Запрос.Выполнить().Выбрать();
    
    // 3. Логика списания по FIFO
    ТекущийТовар = Неопределено;
    ОсталосьСписать = 0;
    
    Пока Выборка.Следующий() Цикл
        
        Если ТекущийТовар <> Выборка.Товар Тогда
            ТекущийТовар = Выборка.Товар;
            ОсталосьСписать = Выборка.НужноСписать;
        КонецЕсли;
        
        Если ОсталосьСписать <= 0 Тогда
            Продолжить; 
        КонецЕсли;
        
        Если Выборка.КоличествоОстаток <= 0 Тогда
            Отказ = Истина;
            Сообщить("Не хватает товара: " + Выборка.Товар);
            Продолжить;
        КонецЕсли;

        // Сколько берем из этой партии
        КоличествоСписать = Мин(ОсталосьСписать, Выборка.КоличествоОстаток);
        
        // Записываем движение в регистр Остатки (Расход)
        Движение = Движения.Остатки.Добавить();
        Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
        Движение.Период = Дата;
        Движение.Товар = Выборка.Товар;
        Движение.Партия = Выборка.Партия;
        Движение.Количество = КоличествоСписать;
        Движение.Цена = Выборка.ЦенаОстаток; // Берем цену из списываемой партии
        Движение.Контрагент = Контрагент;
        
        ОсталосьСписать = ОсталосьСписать - КоличествоСписать;
    КонецЦикла;
    
    // 4. Запись в регистр Продажи
    Для Каждого ТекСтрокаТовары Из Товары Цикл
        ДвижениеПродажи = Движения.Продажи.Добавить();
        ДвижениеПродажи.Период = Дата;
        ДвижениеПродажи.Номенклатура = ТекСтрокаТовары.Наименование;
        ДвижениеПродажи.Количество = ТекСтрокаТовары.Количество;
        ДвижениеПродажи.Выручка = ТекСтрокаТовары.Сумма;
        ДвижениеПродажи.Контрагент = Контрагент;
	КонецЦикла;
	
КонецПроцедуры
