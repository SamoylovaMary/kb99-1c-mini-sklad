		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Товары.Наименование КАК Наименование,
	МАКСИМУМ(ЦеныНоменклатурыСрезПоследних.Цена) КАК Цена,
	СУММА(ОстаткиОстатки.КоличествоОстаток) КАК Количество
ИЗ
	Справочник.Товары КАК Товары
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&amp;Дата, ) КАК ЦеныНоменклатурыСрезПоследних
		ПО ЦеныНоменклатурыСрезПоследних.Товар = Товары.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Остатки.Остатки(&amp;Дата, ) КАК ОстаткиОстатки
		ПО ОстаткиОстатки.Товар = Товары.Ссылка

СГРУППИРОВАТЬ ПО
	Товары.Наименование</query>
